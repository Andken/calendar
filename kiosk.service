[Unit]
Description=Launch Raspberry Pi Calendar Kiosk
After=graphical.target

[Service]
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
WorkingDirectory=/home/pi/calendar
ExecStart=/bin/bash /home/pi/calendar/start-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
